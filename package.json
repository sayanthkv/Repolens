{
  "name": "repolens",
  "private": true,
  "workspaces": ["client", "server", "shared"],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,green\" \"npm run dev --workspace=@repolens/server\" \"npm run dev --workspace=@repolens/client\"",
    "build": "npm run build --workspace=@repolens/shared && npm run build --workspace=@repolens/server && npm run build --workspace=@repolens/client",
    "start": "node server/dist/index.js",
    "test": "npm run test --workspace=@repolens/server",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.13.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}